 impl PostFilterState {
+    pub(crate) fn merge_index_len(&self, other: &Self) -> Option<usize> {
+        [
+            (self.cdef_units.len(), other.cdef_units.len()),
+            (self.cdef_blocks.len(), other.cdef_blocks.len()),
+            (
+                self.transform_boundaries.len(),
+                other.transform_boundaries.len(),
+            ),
+            (self.restoration_units.len(), other.restoration_units.len()),
+            (
+                self.block_filter_states.len(),
+                other.block_filter_states.len(),
+            ),
+        ]
+        .into_iter()
+        .try_fold(0, |largest, (a, b)| {
+            if b == 0 {
+                Some(largest)
+            } else {
+                Some(largest.max(a.checked_add(b)?))
+            }
+        })
+    }
+
+    pub(crate) fn merge_indexed(&mut self, other: Self, scratch: &mut Vec<indexed_merge::Entry>) {
+        if self.is_empty() {
+            *self = other;
+            return;
+        }
+        indexed_merge::merge(&mut self.cdef_units, other.cdef_units, scratch, |v| {
+            (v.x, v.y)
+        });
+        indexed_merge::merge(&mut self.cdef_blocks, other.cdef_blocks, scratch, |v| {
+            (v.x, v.y)
+        });
+        indexed_merge::merge(
+            &mut self.transform_boundaries,
+            other.transform_boundaries,
+            scratch,
+            |v| (v.block.plane, v.block.x, v.block.y, v.block.tx_size as u8),
+        );
+        indexed_merge::merge(
+            &mut self.restoration_units,
+            other.restoration_units,
+            scratch,
+            |v| (v.x, v.y, v.plane),
+        );
+        indexed_merge::merge(
+            &mut self.block_filter_states,
+            other.block_filter_states,
+            scratch,
+            |v| (v.x, v.y),
+        );
+    }
+
     pub(crate) fn merge(&mut self, other: Self) {
